@NasaDataPlatform.API_HostAddress = http://localhost:8000
@missionId = MISSION-DDA661BB110C3994297AF414
@studentId = USER-001

GET {{NasaDataPlatform.API_HostAddress}}/api/missions
Accept: application/json

###
GET {{NasaDataPlatform.API_HostAddress}}/api/missions?type=SOLAR_STORM

###
GET {{NasaDataPlatform.API_HostAddress}}/api/missions/{{missionId}}

### Solar fixture, explicitly not real NASA data
POST {{NasaDataPlatform.API_HostAddress}}/api/missions/generate
Content-Type: application/json

{
  "eventId": "DEMO-FLR-001",
  "type": "SOLAR_STORM",
  "difficulty": "EASY"
}

### Planetary fixture
POST {{NasaDataPlatform.API_HostAddress}}/api/missions/generate
Content-Type: application/json

{
  "eventId": "DEMO-NEO-001",
  "type": "PLANETARY_DEFENSE",
  "difficulty": "MEDIUM"
}

### For this solar fixture B is M5.2. First correct = 100, repeats = 0.
POST {{NasaDataPlatform.API_HostAddress}}/api/students/{{studentId}}/missions/{{missionId}}/answer
Content-Type: application/json

{
  "optionId": "B"
}

### Incorrect answer for this solar fixture
POST {{NasaDataPlatform.API_HostAddress}}/api/students/{{studentId}}/missions/{{missionId}}/answer
Content-Type: application/json

{
  "optionId": "A"
}

